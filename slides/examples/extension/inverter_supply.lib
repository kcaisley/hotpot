/* NangateOpenCellLibrary_typical.lib */
/* Within cell (INV_X1) */
pg_pin(VDD) {
		voltage_name : VDD;
		pg_type      : primary_power;
	}
pg_pin(VSS) {
		voltage_name : VSS;
		pg_type      : primary_ground;
	}
/* Within signal pins A and ZN */
related_power_pin : "VDD";
related_ground_pin : "VSS";
